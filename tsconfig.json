{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["types/**/*.ts", "services/**/*.ts", "composables/**/*.ts", "components/classroom/**/*.vue", "global-top.vue", "custom-nav-controls.vue", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist", ".build-check"]
}
