{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "第 4 课：R 阶段服务（你的工作文件）",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["server:app", "--host", "127.0.0.1", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "第 4 课：E 阶段完整参考（reference）",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["reference.server:app", "--host", "127.0.0.1", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "第 4 课：依赖生命周期探针",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["experiments.dependency_probe:app", "--host", "127.0.0.1", "--port", "8002"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
