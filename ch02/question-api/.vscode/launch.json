{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "第 3 课：起点包服务（你的工作文件）",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["server:app", "--host", "127.0.0.1", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "第 3 课：完整参考对照（reference）",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["reference.server:app", "--host", "127.0.0.1", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "第 3 课：输出对照实验（missing → 500）",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["experiments.output_probe:app", "--host", "127.0.0.1", "--port", "8001"],
      "cwd": "${workspaceFolder}",
      "env": { "PROBE_MODE": "missing" },
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
